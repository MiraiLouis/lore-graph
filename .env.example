# Clé API Mistral (console.mistral.ai). Obligatoire pour sync.py (embeddings) et agent.py.
MISTRAL_API_KEY=

# Modèles Mistral
# mistral-large-latest renvoie parfois finish_reason=error avec des outils liés ; medium est stable.
MISTRAL_CHAT_MODEL=mistral-medium-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Neo4j (docker compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Coffre Obsidian, relatif à la racine du projet
VAULT_PATH=Obsidian/Demo
